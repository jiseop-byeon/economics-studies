#!/bin/sh
# 커밋 전에 데이터 파일을 검사하고(scripts/check.js), 통과하면 사이트 갱신 시각을 적는다(scripts/stamp.js).
# GUI(Claude 앱 등)에서 커밋할 때도 node를 찾도록 흔한 설치 위치를 PATH 앞에 둔다.
export PATH="$HOME/.local/node/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
node scripts/check.js >/dev/null 2>&1 || { echo "scripts/check.js 실패: 커밋을 멈춘다"; node scripts/check.js | tail -5; exit 1; }
node scripts/stamp.js >/dev/null && git add js/meta.js index.html
